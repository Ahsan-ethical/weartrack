generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WardrobeItem {
  id                 String   @id @default(cuid())
  title              String
  category           String
  brand              String
  color              String
  fabric             String
  imageUrl           String?  @map("image_url")
  price              Decimal  @default(0)
  wearCount          Int      @default(0) @map("wear_count")
  totalWears         Int      @default(0) @map("total_wears")
  maxWearsBeforeWash Int      @default(5) @map("max_wears_before_wash")
  lastWornDate       String?  @map("last_worn_date")
  inLaundryQueue     Boolean  @default(false) @map("in_laundry_queue")
  isPacked           Boolean  @default(false) @map("is_packed")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("wardrobe_items")
}

model OutfitLog {
  id        String   @id @default(cuid())
  date      String
  itemIds   String[] @map("item_ids")
  tags      Json     @default("{}")
  note      String?
  photoUrl  String?  @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("outfit_logs")
}